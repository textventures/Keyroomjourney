doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        script(src="https://telegram.org/js/telegram-web-app.js")
        script(src="/static/js/waxjs.bundle.js")
        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css", rel="stylesheet", integrity="sha384-wEmeIV1mKuiNpC+IOBjI7aAzPcEZeedi5yW5f2yOq55WWLwNGmvvx4Um1vskeMj0" crossorigin="anonymous")
        title KEY JOURNEY
        style.
            .MainBox {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                text-align: center;
                padding: 20px 20px;
                margin: 20px 20px;
                box-shadow: 0px 2px 18px 0px rgba(0, 0, 0, 0.3);
            }
            .MainBox *{
                margin: 10px 0px;
            }
    body
        div.MainBox#root
            h1 KeyRoom Journey Sign-in
            p Sign in with your WAX Cloud Wallet to continue your journey.
            button#login.btn.btn-primary(type="button") Log in with WAX Cloud Wallet
            p#status
    script(src="/static/js/signin.js")
